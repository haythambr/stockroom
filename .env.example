# PostgreSQL connection. With Docker Compose this is set for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockroom?schema=public"
# Separate database for the end-to-end tests (it is wiped on every run).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockroom_test?schema=public"

# At least 32 random characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-at-least-32-random-characters"
# Shared with the payment provider to sign webhooks. At least 16 characters.
PAYMENT_WEBHOOK_SECRET="whsec_change_me_please"

PORT=3000
# Access token lifetime and how long an unpaid order holds its stock.
JWT_ACCESS_TTL_SECONDS=900
ORDER_PAYMENT_MINUTES=30

# Lets the shop website pay orders with a "Pay now (demo)" button. Never turn on in production.
DEMO_PAYMENTS=false
